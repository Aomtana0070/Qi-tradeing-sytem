################################################################################
# IQ OPTION AI TRADING BOT - ENVIRONMENT CONFIGURATION
# ⚠️  SECURITY: This file contains sensitive credentials. NEVER commit to git!
################################################################################

# ==================== IQ OPTION CREDENTIALS ====================
# Get these from your IQ Option account at https://iqoption.com
IQ_EMAIL=example_email@example.com
IQ_PASSWORD=example_password_here

# ==================== ACCOUNT SETTINGS ====================
# ALWAYS use PRACTICE for testing. Only change to REAL after extensive backtesting.
NODE_ENV=development
ACCOUNT_TYPE=PRACTICE
ACCOUNT_CURRENCY=USD
USD_TO_THB_RATE=35

# ==================== AI CHAT (Dashboard — Gemini) ====================
# Get key: https://aistudio.google.com/apikey
AI_API_KEY=your_gemini_api_key_here
# ใช้ lite ประหยัด quota | gemini-2.0-flash-lite, gemini-2.5-flash-lite
AI_MODEL=gemini-2.0-flash-lite
# offline = ไม่เรียก Gemini (ใช้ bot context ในตัว) | gemini = เรียก API
AI_CHAT_MODE=gemini
# ห่างขั้นต่ำระหว่างคำถาม (ms) ป้องกัน spam quota
AI_CHAT_MIN_INTERVAL_MS=8000

# ==================== OPTIONAL: TELEGRAM ALERTS ====================
# Leave empty to disable Telegram alerts
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==================== PAPER TRADING MODE ====================
# ⚠️  CRITICAL: Default is true (safe). Only set false when 100% ready for real money.
# Before setting to false, you MUST:
#   1. Run 30+ days of backtesting
#   2. Paper trade with PRACTICE account for 30+ days
#   3. Have written confirmation and risk acceptance
PAPER_TRADE_MODE=true

# ==================== LOGGING ====================
LOG_LEVEL=info
# Levels: debug | info | warn | error
DEBUG=false

# ==================== DASHBOARD ====================
DASHBOARD_PORT=3001
DASHBOARD_HOST=localhost

# ==================== ADVANCED (do not change without understanding) ====================
API_TIMEOUT_MS=10000
RECONNECT_MAX_RETRIES=5
SESSION_HEARTBEAT_MS=30000
MIN_SECONDS_BETWEEN_TRADES=5

# ==================== FEATURE FLAGS ====================
ENABLE_TELEGRAM_ALERTS=false
ENABLE_TRADE_CSV_LOGGING=true
ENABLE_PERFORMANCE_TRACKING=true
REQUIRE_USER_CONFIRMATION_FOR_LIVE=true
VALIDATE_API_RESPONSES=true
ENABLE_PANIC_STOP=true

# ==================== EXPERIMENTAL FEATURES ====================
USE_MULTIPLE_TIMEFRAMES=false
USE_VOLUME_ANALYSIS=false
USE_SUPPORT_RESISTANCE=false
